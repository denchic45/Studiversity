CREATE TABLE IF NOT EXISTS studyGroupCourse (
    study_group_id TEXT NOT NULL,
    course_id TEXT NOT NULL,
    PRIMARY KEY(study_group_id, course_id),
    FOREIGN KEY (study_group_id) REFERENCES studyGroup(study_group_id) ON DELETE CASCADE,
    FOREIGN KEY (course_id) REFERENCES course(course_id) ON DELETE CASCADE,
    UNIQUE(study_group_id, course_id)
);

upsert:
INSERT INTO studyGroupCourse
VALUES ?
ON CONFLICT(study_group_id, course_id)
DO UPDATE SET
study_group_id = excluded.study_group_id,
course_id = excluded.course_id;

deleteByGroupId:
DELETE FROM studyGroupCourse WHERE study_group_id =:groupId;

deleteByCourseId:
DELETE FROM studyGroupCourse WHERE course_id =:courseId;